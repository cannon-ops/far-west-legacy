# Far West Legacy — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# Anthropic API (BYOK — user supplies their own key)
ANTHROPIC_API_KEY=sk-ant-...

# FamilySearch OAuth 2.0 — public client (AppKey only, no secret)
# Register your app at https://developers.familysearch.org
FAMILYSEARCH_CLIENT_ID=
FAMILYSEARCH_REDIRECT_URI=http://localhost:8081/callback

# Environment: beta (development) or production
# Use beta until Compatibility Review is passed
FAMILYSEARCH_ENV=beta

# Space-delimited OAuth scope names, confirmed via the first live sign-in handshake
# and recorded in repo-memory.md. Leave blank to let FamilySearch grant the beta
# AppKey's default scope.
FAMILYSEARCH_SCOPE=

# Diagnostic toggle for the FWL-010 auth-failure investigation (repo-memory.md
# Pending Decisions). PKCE (S256) is the correct default for a public client —
# leave at 1. Set to 0 ONLY to isolation-test whether this beta AppKey rejects
# PKCE at /authorize. Flip back to 1 once the isolation test result is recorded.
FAMILYSEARCH_USE_PKCE=1

# M2.2 match-check + confirm-gate screen (/upload/<job_id>). Gated off by default
# per plan §0 — the registered redirect_uri is localhost-only, so this only ever
# works on Dev. Set to 1 locally to use it.
FWL_FS_UPLOAD_ENABLED=0

# DRY-RUN mode for the upload journal (plan §4.4). Read-only calls (auth, match
# search) still execute for real; POST/PUT/DELETE writes are logged, not sent.
FWL_FS_DRY_RUN=0

# Flask session signing key
# REQUIRED in production (set in Render dashboard). May stay unset locally —
# src/app.py falls back to a dev-only placeholder if FLASK_SECRET_KEY is missing.
FLASK_SECRET_KEY=
